{
  "name": "homebridge-tapo-stoyanov",
  "version": "2.1.1",
  "description": "Homebridge plugin for Tapo smart devices (lights, bulbs) that are not Matter compatible",
  "main": "dist/index.js",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "lint": "eslint src/**.ts",
    "build": "rimraf ./dist && tsc",
    "watch": "tsc -w",
    "prepublishOnly": "pnpm run lint && pnpm run build",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [
    "homebridge-plugin",
    "tapo",
    "tp-link",
    "smart-light",
    "smart-bulb",
    "L430C"
  ],
  "engines": {
    "node": "^18.17.0 || ^20.9.0 || ^22.0.0",
    "homebridge": "^1.6.0"
  },
  "author": "stoyanov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stoyanov-x/homebridge-tapo-stoyanov.git"
  },
  "bugs": {
    "url": "https://github.com/stoyanov-x/homebridge-tapo-stoyanov/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/stoyanov-x/homebridge-tapo-stoyanov"
  },
  "homepage": "https://github.com/stoyanov-x/homebridge-tapo-stoyanov#readme",
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^1.0.3",
    "axios": "^1.6.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-sealedbox-js": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "homebridge": "^1.6.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0"
  }
}
