{
  "pluginAlias": "TapoStoyanov",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Configure your Tapo smart devices with an easy-to-use interface. This plugin supports automatic device discovery and encrypted credential storage.",
  "footerDisplay": "For support and documentation, visit the [GitHub repository](https://github.com/stoyanov-x/homebridge-tapo-stoyanov).",
  "customUi": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Tapo Platform"
      },
      "email": {
        "title": "TP-Link Account Email",
        "type": "string",
        "required": true,
        "description": "Your TP-Link/Tapo account email address (encrypted)"
      },
      "password": {
        "title": "TP-Link Account Password",  
        "type": "string",
        "required": true,
        "description": "Your TP-Link/Tapo account password (encrypted)"
      },
      "isEncrypted": {
        "title": "Credentials Encrypted",
        "type": "boolean",
        "default": false,
        "description": "Whether credentials are encrypted"
      },
      "devices": {
        "title": "Devices",
        "type": "array",
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Device Name",
              "type": "string",
              "required": true,
              "description": "Friendly name for the device"
            },
            "ip": {
              "title": "IP Address",
              "type": "string",
              "required": true,
              "description": "Local IP address of the device"
            },
            "type": {
              "title": "Device Type",
              "type": "string",
              "required": true,
              "default": "light",
              "oneOf": [
                { "title": "Light Bulb", "enum": ["light"] }
              ],
              "description": "Type of Tapo device"
            },
            "mac": {
              "title": "MAC Address",
              "type": "string",
              "description": "Device MAC address"
            },
            "model": {
              "title": "Model",
              "type": "string",
              "description": "Device model"
            }
          }
        }
      },
      "pollingInterval": {
        "title": "Polling Interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 10,
        "maximum": 300,
        "description": "How often to poll devices for status updates (10-300 seconds)"
      }
    }
  }
}
